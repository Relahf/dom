# ==========================================
# APARTMENT HUB — CONFIGURATION
# ==========================================

# === ПРИЛОЖЕНИЕ ===
SECRET_KEY=your-super-secret-key-change-me-in-production
DEBUG=false
APP_TITLE=Apartment Hub
DEFAULT_ADMIN_USERNAME=admin

# === OLLAMA / LLM (НЕЙРОСЕТЬ) ===
OLLAMA_API_URL=http://ollama:11434
LLM_MODEL_NAME=tinyllama
LLM_DAILY_LIMIT=10
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=512

# === ФАЙЛООБМЕННИК ===
MAX_FILE_SIZE_MB=100
MAX_STORAGE_MB=5000
ALLOWED_EXTENSIONS=*

# === ЧАТ ===
AUTO_DELETE_MESSAGES_DAYS=90
MAX_MESSAGE_LENGTH=5000

# === NUT (ИБП/UPS Мониторинг) ===
# Оставьте пусто если ИБП не используется
NUT_HOST=
NUT_PORT=3493
NUT_USERNAME=
NUT_PASSWORD=
NUT_UPS_NAME=

# === ПУТИ В КОНТЕЙНЕРЕ ===
UPLOAD_DIR=/uploads
BACKUP_DIR=/backups
DATABASE_PATH=/app/data/apartment_hub.db

# === РЕЗЕРВНЫЕ КОПИИ ===
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=false
AUTO_BACKUP_HOUR=2

# === СЕТЬ ===
ALL_DOMAINS=true
